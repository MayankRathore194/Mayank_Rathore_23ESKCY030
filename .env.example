# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git.

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.rawu8tm.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=pharmacy_inventory

# Days-before-expiry window used by the Alerts page
EXPIRY_ALERT_DAYS=30

# Daily job (POST /clock): flag batches expiring within this many days
DAILY_QUARANTINE_DAYS=7

# Re-order alert threshold per medicine (graded via GET /outbox)
REORDER_THRESHOLD=10
